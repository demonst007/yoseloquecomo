# Copy to .env.local and fill in with your Supabase project values
# (Supabase dashboard > Project Settings > API).
# Without them the app runs in local-only mode: no account, no AI, data stays on the device.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
